if ($host.Runspace.ApartmentState -ne "STA") {
    powershell -STA -ExecutionPolicy Bypass -File $PSCommandPath
    exit
}

Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing

$apiSignature = @"
using System;
using System.Runtime.InteropServices;

public class API {
    [DllImport("user32.dll")] public static extern short GetAsyncKeyState(int vKey);
    [DllImport("user32.dll")] public static extern void mouse_event(int dwFlags, int dx, int dy, int dwData, int dwExtraInfo);
    [DllImport("user32.dll")] public static extern bool SetWindowDisplayAffinity(IntPtr hWnd, uint dwAffinity);
}
"@
Add-Type -TypeDefinition $apiSignature

$script:LeftBindKey = 0
$script:RightBindKey = 0
$script:LeftCPS = 12
$script:RightCPS = 12
$script:MinCPS = 1
$script:MaxCPS = 25
$script:JitterEnabled = $false
$script:isDraggingL = $false
$script:isDraggingR = $false

$script:stopwatch = [System.Diagnostics.Stopwatch]::StartNew()
$script:lastLeftClick = 0
$script:lastRightClick = 0
$script:nextLeftDelay = 0
$script:nextRightDelay = 0

function IsKeyDown($k) {
    if($k -eq 0) { return $false }
    return (([API]::GetAsyncKeyState($k) -band 0x8000) -ne 0)
}

function GetKeyName($k) {
    $names = @{0="...";1="LMB";2="RMB";4="MMB";5="MB4";6="MB5";32="Space";16="Shift";17="Ctrl";18="Alt"}
    65..90|%{$names[$_]=[char]$_}
    112..123|%{$names[$_]="F"+($_-111)}
    if($names[$k]){return $names[$k]}
    return "K:$k"
}

function GetNextDelay($cps) {
    if ($cps -le 0) { return 1000 }
    $vCPS = $cps + (Get-Random -Min -1.5 -Max 1.5)
    return 1000.0 / $vCPS
}

function DoLeftClick {
    if ($script:JitterEnabled) {
        [API]::mouse_event(0x0001, (Get-Random -Min -1 -Max 2), (Get-Random -Min -1 -Max 2), 0, 0)
    }
    [API]::mouse_event(0x0002, 0, 0, 0, 0)
    [System.Threading.Thread]::Sleep((Get-Random -Min 4 -Max 10))
    [API]::mouse_event(0x0004, 0, 0, 0, 0)
}

function DoRightClick {
    if ($script:JitterEnabled) {
        [API]::mouse_event(0x0001, (Get-Random -Min -1 -Max 2), (Get-Random -Min -1 -Max 2), 0, 0)
    }
    [API]::mouse_event(0x0008, 0, 0, 0, 0)
    [System.Threading.Thread]::Sleep((Get-Random -Min 4 -Max 10))
    [API]::mouse_event(0x0010, 0, 0, 0, 0)
}

