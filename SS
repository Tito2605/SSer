# Main Timer
$timer = New-Object System.Windows.Forms.Timer
$timer.Interval = 1
$timer.Add_Tick({
    $now = $script:sw.ElapsedMilliseconds

    # F10: Ghost Mode
    if(IsDown 0x79){
        if(($now - $script:LastToggle) -gt 500){
            $script:IsHidden = -not $script:IsHidden
            if($script:IsHidden){
                $f.Hide()
                $f.ShowInTaskbar = $false
                $f.Text = "appmodel"
            } else {
                $f.Text = "Icon1CClicker"
                $f.ShowInTaskbar = $true
                $f.Show()
            }
            $script:LastToggle = $now
        }
    }

    # Key binding
    if($script:lisL -or $script:lisR){
        for($i=1; $i -le 190; $i++){
            if(IsDown $i){
                if($script:lisL){
                    if($i -eq 27){
                        $script:LeftBind = 0
                        $bindLeft.Text = "NONE"
                        $bindLeft.ForeColor = [System.Drawing.Color]::White
                    } else {
                        $script:LeftBind = $i
                        $bindLeft.Text = GetName $i
                        $bindLeft.ForeColor = [System.Drawing.Color]::White
                    }
                    $script:lisL = $false
                }
                elseif($script:lisR){
                    if($i -eq 27){
                        $script:RightBind = 0
                        $bindRight.Text = "NONE"
                        $bindRight.ForeColor = [System.Drawing.Color]::White
                    } else {
                        $script:RightBind = $i
                        $bindRight.Text = GetName $i
                        $bindRight.ForeColor = [System.Drawing.Color]::White
                    }
                    $script:lisR = $false
                }
                Start-Sleep -Milliseconds 250
                return
            }
        }
        return
    }

    # Auto clicking
    if($script:LeftBind -ne 0 -and (IsDown $script:LeftBind)){
        if(($now - $script:lLast) -ge $script:lDelay){
            SendClick $true
            $script:lLast = $script:sw.ElapsedMilliseconds
            $script:lDelay = GetDelay $script:LeftCPS
        }
    }
    
    if($script:RightBind -ne 0 -and (IsDown $script:RightBind)){
        if(($now - $script:rLast) -ge $script:rDelay){
            SendClick $false
            $script:rLast = $script:sw.ElapsedMilliseconds
            $script:rDelay = GetDelay $script:RightCPS
        }
    }
})
$timer.Start()

$f.Add_FormClosing({
