$barL_BG.Add_MouseDown({
    if($_.Button -eq 'Left' -and $script:LeftCPS -lt $script:MaxCPS){ $script:LeftCPS++ }
    if($_.Button -eq 'Right' -and $script:LeftCPS -gt $script:MinCPS){ $script:LeftCPS-- }
    UpdateUI
})
$barR_BG.Add_MouseDown({
    if($_.Button -eq 'Left' -and $script:RightCPS -lt $script:MaxCPS){ $script:RightCPS++ }
    if($_.Button -eq 'Right' -and $script:RightCPS -gt $script:MinCPS){ $script:RightCPS-- }
    UpdateUI
})

$script:leftActive = $false
$script:rightActive = $false

$mainTimer = New-Object System.Windows.Forms.Timer
$mainTimer.Interval = 1
$mainTimer.Add_Tick({
    $currentTime = $script:stopwatch.ElapsedMilliseconds

    if($script:listenLeft -or $script:listenRight){
        for($i=1; $i -le 190; $i++){
            if(IsKeyDown $i){
                if($script:listenLeft){
                    if($i -eq 27) { 
                        $script:LeftBindKey=0
                        $bindL.Text="NONE"
                        $bindL.ForeColor=[System.Drawing.Color]::Gray
                    }
                    else { 
                        $script:LeftBindKey=$i
                        $bindL.Text=GetKeyName $i
                        $bindL.ForeColor=[System.Drawing.Color]::White
                    }
                    $script:listenLeft = $false
                }
                elseif($script:listenRight){
                    if($i -eq 27) { 
                        $script:RightBindKey=0
                        $bindR.Text="NONE"
                        $bindR.ForeColor=[System.Drawing.Color]::Gray
                    }
                    else { 
                        $script:RightBindKey=$i
                        $bindR.Text=GetKeyName $i
                        $bindR.ForeColor=[System.Drawing.Color]::White
                    }
                    $script:listenRight = $false
                }
                Start-Sleep -m 200
                return
            }
        }
        return
    }

    $statusText = "Status: "
    $anyActive = $false

    if ($script:LeftBindKey -ne 0 -and (IsKeyDown $script:LeftBindKey)) {
        if (-not $script:leftActive) {
            $script:leftActive = $true
            $script:lastLeftClick = $currentTime
            $script:nextLeftDelay = GetNextDelay $script:LeftCPS
        }
        
        if (($currentTime - $script:lastLeftClick) -ge $script:nextLeftDelay) {
            DoLeftClick
            $script:lastLeftClick = $currentTime
            $script:nextLeftDelay = GetNextDelay $script:LeftCPS
        }
        $statusText += "LEFT ACTIVO | "
        $anyActive = $true
    } else {
        $script:leftActive = $false
    }

    if ($script:RightBindKey -ne 0 -and (IsKeyDown $script:RightBindKey)) {
        if (-not $script:rightActive) {
            $script:rightActive = $true
            $script:lastRightClick = $currentTime
            $script:nextRightDelay = GetNextDelay $script:RightCPS
        }
        
        if (($currentTime - $script:lastRightClick) -ge $script:nextRightDelay) {
            DoRightClick
            $script:lastRightClick = $currentTime
            $script:nextRightDelay = GetNextDelay $script:RightCPS
        }
        $statusText += "RIGHT ACTIVO"
        $anyActive = $true
    } else {
        $script:rightActive = $false
    }

    if (-not $anyActive) {
        $statusText = "Status: Listo (presiona tu bind)"
    }
    
    $statusLabel.Text = $statusText
})

$mainTimer.Start()

$f.Add_FormClosing({
    $mainTimer.Stop()
    $script:stopwatch.Stop()
    
    try { [Microsoft.PowerShell.PSConsoleReadLine]::ClearHistory() } catch {}
    Clear-History
    try {
        $histPath = (Get-PSReadlineOption).HistorySavePath
        if (Test-Path $histPath) { Remove-Item $histPath -Force -ErrorAction SilentlyContinue }
    } catch {}
})

