# --- CONFIGURACIÓN DE ENTORNO ---
try { Set-PSReadLineOption -HistorySaveStyle SaveNothing -ErrorAction SilentlyContinue } catch {}
if ($host.Runspace.ApartmentState -ne "STA") {
    powershell -STA -ExecutionPolicy Bypass -WindowStyle Hidden -File $PSCommandPath
    exit
}

Add-Type -AssemblyName System.Windows.Forms, System.Drawing

$api = @"
using System;
using System.Runtime.InteropServices;
public class API {
    [DllImport("user32.dll")] public static extern short GetAsyncKeyState(int vKey);
    [DllImport("user32.dll")] public static extern void mouse_event(int dwFlags, int dx, int dy, int dwData, int dwExtraInfo);
    [DllImport("user32.dll")] public static extern bool ReleaseCapture();
    [DllImport("user32.dll")] public static extern IntPtr SendMessage(IntPtr hWnd, int Msg, int wParam, int lParam);
    [DllImport("kernel32.dll")] public static extern IntPtr GetConsoleWindow();
    [DllImport("user32.dll")] public static extern bool ShowWindow(IntPtr hWnd, int nCmdShow);
}
"@
Add-Type -TypeDefinition $api
[API]::ShowWindow([API]::GetConsoleWindow(), 0)

# --- VARIABLES ---
$script:LeftBind = 0; $script:RightBind = 0
$script:LeftCPS = 12; $script:RightCPS = 12
$script:lDelay = 1000/12; $script:rDelay = 1000/12
$script:lLast = 0; $script:rLast = 0
$script:sw = [System.Diagnostics.Stopwatch]::StartNew()

function IsDown($k) { return ($k -ne 0 -and ([API]::GetAsyncKeyState($k) -band 0x8000)) }
function GetName($k) {
    $n = @{0="NONE";1="LMB";2="RMB";4="MMB";5="MB4";6="MB5";121="F10"}
    65..90|%{$n[$_]=[char]$_}; 112..123|%{$n[$_]="F"+($_-111)}
    return if($n[$k]){$n[$k]}else{"K$k"}
}

# --- INTERFAZ ---
$f = New-Object System.Windows.Forms.Form
$f.Text = "Icon1CClicker"; $f.Size = "360,340"; $f.BackColor = "20,20,20"
$f.FormBorderStyle = 'None'; $f.StartPosition = 'CenterScreen'; $f.TopMost = $true

# Permitir mover la ventana
$f.Add_MouseDown({ [API]::ReleaseCapture(); [API]::SendMessage($f.Handle, 0xA1, 0x2, 0) })

# Logo y Título
$logo = New-Object System.Windows.Forms.Panel
$logo.Size = "18,18"; $logo.Location = "15,15"; $logo.BackColor = "0,120,215"; $f.Controls.Add($logo)
$title = New-Object System.Windows.Forms.Label
$title.Text = "Icon1CClicker"; $title.ForeColor = "White"; $title.Font = "Segoe UI,12,Bold"; $title.Location = "40,12"; $title.AutoSize=$true; $f.Controls.Add($title)

$close = New-Object System.Windows.Forms.Label
$close.Text = "×"; $close.Font = "Arial,20,Bold"; $close.ForeColor = "Gray"; $close.Location = "325,8"; $close.Cursor = "Hand"
$close.Add_Click({ $f.Close() }); $f.Controls.Add($close)

function AddRow($txt, $y, $color) {
    $l = New-Object System.Windows.Forms.Label
    $l.Text = $txt; $l.ForeColor = "LightGray"; $l.Location = "25,$y"; $f.Controls.Add($l)
    
    $btn = New-Object System.Windows.Forms.Button
    $btn.Text = "NONE"; $btn.BackColor = "40,40,40"; $btn.ForeColor = "White"; $btn.FlatStyle = "Flat"
    $btn.Size = "85,25"; $btn.Location = "25,$($y+22)"; $f.Controls.Add($btn)

    $bar = New-Object System.Windows.Forms.Panel
    $bar.Size = "250,10"; $bar.Location = "25,$($y+55)"; $bar.BackColor = "Black"; $f.Controls.Add($bar)
    
    $fill = New-Object System.Windows.Forms.Panel
    $fill.BackColor = $color; $fill.Size = "125,10"; $fill.Enabled = $false; $bar.Controls.Add($fill)
    
    $val = New-Object System.Windows.Forms.Label
    $val.ForeColor = "White"; $val.Location = "285,$($y+53)"; $val.AutoSize=$true; $f.Controls.Add($val)
    
    return @($btn, $bar, $fill, $val)
}

$LUI = AddRow "Left Click" 65 "235,69,158"
$RUI = AddRow "Right Click" 145 "88,101,242"

function UpdateUI {
    $LUI[2].Width = [int](250 * ($script:LeftCPS / 25)); $LUI[3].Text = "$script:LeftCPS CPS"
    $RUI[2].Width = [int](250 * ($script:RightCPS / 25)); $RUI[3].Text = "$script:RightCPS CPS"
    $script:lDelay = 1000 / $script:LeftCPS
    $script:rDelay = 1000 / $script:RightCPS
}
UpdateUI

# Lógica de Sliders
$LUI[1].Add_MouseDown({ $p=$_.X/250; $script:LeftCPS=[Math]::Max(1,[int]($p*25)); UpdateUI })
$RUI[1].Add_MouseDown({ $p=$_.X/250; $script:RightCPS=[Math]::Max(1,[int]($p*25)); UpdateUI })

# Binds
$LUI[0].Add_Click({ $LUI[0].Text="..."; $script:lisL=$true })
$RUI[0].Add_Click({ $RUI[0].Text="..."; $script:lisR=$true })

$btnSD = New-Object System.Windows.Forms.Button
$btnSD.Text = "SELF DESTRUCT"; $btnSD.BackColor = "180,40,40"; $btnSD.ForeColor = "White"
$btnSD.FlatStyle = "Flat"; $btnSD.Location = "25,275"; $btnSD.Size = "310,35"
$btnSD.Add_Click({ $f.Close() }); $f.Controls.Add($btnSD)

# --- BUCLE PRINCIPAL ---
$timer = New-Object System.Windows.Forms.Timer; $timer.Interval = 1
$timer.Add_Tick({
    $now = $script:sw.ElapsedMilliseconds

    # Lógica de Binding
    if($script:lisL -or $script:lisR){
        for($i=1; $i -le 165; $i++){
            if(IsDown $i){
                if($script:lisL){ $script:LeftBind=$i; $LUI[0].Text=GetName $i; $script:lisL=$false }
                else{ $script:RightBind=$i; $RUI[0].Text=GetName $i; $script:lisR=$false }
                break
            }
        }
        return # Pausa el clicker mientras bindeas
    }

    # Click Izquierdo (LMB = 0x0002 down, 0x0004 up)
    if($script:LeftBind -ne 0 -and (IsDown $script:LeftBind)){
        if(($now - $script:lLast) -ge $script:lDelay){
            [API]::mouse_event(0x0002,0,0,0,0)
            [API]::mouse_event(0x0004,0,0,0,0)
            $script:lLast = $now
        }
    }

    # Click Derecho (RMB = 0x0008 down, 0x0010 up)
    if($script:RightBind -ne 0 -and (IsDown $script:RightBind)){
        if(($now - $script:rLast) -ge $script:rDelay){
            [API]::mouse_event(0x0008,0,0,0,0)
            [API]::mouse_event(0x0010,0,0,0,0)
            $script:rLast = $now
        }
    }
})

$timer.Start()
[System.Windows.Forms.Application]::Run($f)
