# ===============================
# TIMERS
# ===============================
$LT = New-Object System.Windows.Forms.Timer
$LT.Add_Tick({
    LeftClick
    $LT.Interval = CPSDelay $script:LeftCPS
})

$RT = New-Object System.Windows.Forms.Timer
$RT.Add_Tick({
    RightClick
    $RT.Interval = CPSDelay $script:RightCPS
})

$MON = New-Object System.Windows.Forms.Timer
$MON.Interval = 8
$MON.Add_Tick({
    # Listen for keys
    if($script:listenLeft){
        1..254|%{
            if(IsKeyDown $_){
                if($_ -eq 27){
                    $script:LeftBind = 0
                    $leftBind.Text = "none"
                    $leftBind.ForeColor = [System.Drawing.Color]::Gray
                } else {
                    $script:LeftBind = $_
                    $leftBind.Text = GetKeyName $_
                    $leftBind.ForeColor = [System.Drawing.Color]::White
                }
                $script:listenLeft = $false
                Start-Sleep -m 200
                return
            }
        }
    }
    
    if($script:listenRight){
        1..254|%{
            if(IsKeyDown $_){
                if($_ -eq 27){
                    $script:RightBind = 0
                    $rightBind.Text = "none"
                    $rightBind.ForeColor = [System.Drawing.Color]::Gray
                } else {
                    $script:RightBind = $_
                    $rightBind.Text = GetKeyName $_
                    $rightBind.ForeColor = [System.Drawing.Color]::White
                }
                $script:listenRight = $false
                Start-Sleep -m 200
                return
            }
        }
    }
    
    # Left clicker
    $leftPressed = IsKeyDown $script:LeftBind
    if($leftPressed -and -not $script:leftClickerActive){
        $script:leftClickerActive = $true
        $LT.Interval = CPSDelay $script:LeftCPS
        $LT.Start()
    }
    elseif(-not $leftPressed -and $script:leftClickerActive){
        $script:leftClickerActive = $false
        $LT.Stop()
    }
    
    # Right clicker
    $rightPressed = IsKeyDown $script:RightBind
    if($rightPressed -and -not $script:rightClickerActive){
        $script:rightClickerActive = $true
        $RT.Interval = CPSDelay $script:RightCPS
        $RT.Start()
    }
    elseif(-not $rightPressed -and $script:rightClickerActive){
        $script:rightClickerActive = $false
        $RT.Stop()
    }
})
$MON.Start()

$f.Add_FormClosing({
    $LT.Stop()
    $RT.Stop()
    $MON.Stop()
})

[System.Windows.Forms.Application]::Run($f)
