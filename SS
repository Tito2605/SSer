$api = @"
using System;
using System.Runtime.InteropServices;
public class API {
    [DllImport("user32.dll")] public static extern short GetAsyncKeyState(int vKey);
    [DllImport("user32.dll")] public static extern uint SendInput(uint nInputs, INPUT[] pInputs, int cbSize);
    [DllImport("user32.dll")] public static extern IntPtr GetMessageExtraInfo();
    [DllImport("user32.dll")] public static extern bool SetWindowDisplayAffinity(IntPtr hWnd, uint dwAffinity);
    [DllImport("user32.dll")] public static extern bool ShowWindow(IntPtr hWnd, int nCmdShow);
    [DllImport("kernel32.dll")] public static extern IntPtr GetConsoleWindow();
    
    [StructLayout(LayoutKind.Sequential)]
    public struct INPUT {
        public uint type;
        public MOUSEINPUT mi;
    }
    
    [StructLayout(LayoutKind.Sequential)]
    public struct MOUSEINPUT {
        public int dx;
        public int dy;
        public uint mouseData;
        public uint dwFlags;
        public uint time;
        public IntPtr dwExtraInfo;
    }
    
    public const int INPUT_MOUSE = 0;
    public const uint MOUSEEVENTF_LEFTDOWN = 0x0002;
    public const uint MOUSEEVENTF_LEFTUP = 0x0004;
    public const uint MOUSEEVENTF_RIGHTDOWN = 0x0008;
    public const uint MOUSEEVENTF_RIGHTUP = 0x0010;
}
"@
Add-Type -TypeDefinition $api

[API]::ShowWindow([API]::GetConsoleWindow(), 0)

$script:LeftBind = 0; $script:RightBind = 0
$script:LeftCPS = 12; $script:RightCPS = 12
$script:Jitter = $false; $script:IsHidden = $false
$script:LastToggle = 0
$script:sw = [System.Diagnostics.Stopwatch]::StartNew()
$script:lLast = 0; $script:rLast = 0
$script:lDelay = 0; $script:rDelay = 0

function IsDown($k) { 
    if($k -eq 0){return $false}
    return (([API]::GetAsyncKeyState($k) -band 0x8000) -ne 0)
}

function GetName($k) {
    $n = @{0="NONE";1="LMB";2="RMB";4="MMB";5="MB4";6="MB5";32="Space";16="Shift";17="Ctrl";18="Alt";121="F10"}
    65..90|%{$n[$_]=[char]$_}
    48..57|%{$n[$_]=[char]$_}
    112..123|%{$n[$_]="F"+($_-111)}
    return if($n[$k]){$n[$k]}else{"K$k"}
}

function GetDelay($cps) {
    $base = 1000.0 / $cps
    $variance = if($script:Jitter){ $base * 0.15 } else { $base * 0.08 }
    $jitter = Get-Random -Minimum (-$variance) -Maximum ($variance)
    return [Math]::Max(1, $base + $jitter)
}

function SendClick($isLeft) {
    $down = New-Object API+INPUT
    $down.type = [API]::INPUT_MOUSE
    $down.mi.dwFlags = if($isLeft){[API]::MOUSEEVENTF_LEFTDOWN}else{[API]::MOUSEEVENTF_RIGHTDOWN}
    $down.mi.dwExtraInfo = [API]::GetMessageExtraInfo()
    
    $up = New-Object API+INPUT
    $up.type = [API]::INPUT_MOUSE
    $up.mi.dwFlags = if($isLeft){[API]::MOUSEEVENTF_LEFTUP}else{[API]::MOUSEEVENTF_RIGHTUP}
    $up.mi.dwExtraInfo = [API]::GetMessageExtraInfo()
    
    [void][API]::SendInput(1, @($down), [System.Runtime.InteropServices.Marshal]::SizeOf($down))
    Start-Sleep -Milliseconds (Get-Random -Minimum 12 -Maximum 28)
    [void][API]::SendInput(1, @($up), [System.Runtime.InteropServices.Marshal]::SizeOf($up))
}

