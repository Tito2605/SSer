# ===============================
# FORZAR STA
# ===============================
if ($host.Runspace.ApartmentState -ne "STA") {
    powershell -STA -ExecutionPolicy Bypass -File $PSCommandPath
    exit
}

Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing

# ===============================
# API
# ===============================
Add-Type @"
using System;
using System.Runtime.InteropServices;
public class API {
    [DllImport("user32.dll")] public static extern short GetAsyncKeyState(int vKey);
    [DllImport("user32.dll")] public static extern void mouse_event(int a, int b, int c, int d, int e);
}
"@

# ===============================
# CONFIG
# ===============================
$BindKey = 1        # 1=LMB | 2=RMB | 0x46=F | etc
$MinCPS = 0
$MaxCPS = 25
$LeftCPS = 12
$Enabled = $true

# ===============================
# FUNCIONES
# ===============================
function IsBindDown {
    return (([API]::GetAsyncKeyState($BindKey) -band 0x8000) -ne 0)
}

function CPSDelay($cps) {
    if ($cps -le 0) { return 1000 }
    $base   = 1000 / $cps
    $jitter = Get-Random -Minimum (-$base * 0.20) -Maximum ($base * 0.20)
    $butter = Get-Random -Minimum 1 -Maximum 4
    return [Math]::Max(1, [int]($base + $jitter + $butter))
}

function LeftClick {
    [API]::mouse_event(2,0,0,0,0)
    [API]::mouse_event(4,0,0,0,0)
}

# ===============================
# FORM
# ===============================
$f = New-Object System.Windows.Forms.Form
$f.Text = "Icon1CClicker"
$f.Size = '320,220'
$f.StartPosition = 'CenterScreen'
$f.BackColor = [System.Drawing.Color]::FromArgb(20,20,20)
$f.FormBorderStyle = 'FixedSingle'
$f.MaximizeBox = $false
$f.ShowInTaskbar = $true
$f.Opacity = 1

# ===============================
# TITLE
# ===============================
$title = New-Object System.Windows.Forms.Label
$title.Text = "Icon1CClicker"
$title.ForeColor = [System.Drawing.Color]::Red
$title.Font = New-Object System.Drawing.Font("Segoe UI",14,[System.Drawing.FontStyle]::Bold)
$title.AutoSize = $true
$title.Location = '80,10'
$f.Controls.Add($title)

# ===============================
# CPS TEXT
# ===============================
$cpsText = New-Object System.Windows.Forms.Label
$cpsText.Text = "CPS"
$cpsText.ForeColor = 'Gray'
$cpsText.Location = '20,55'
$f.Controls.Add($cpsText)

# ===============================
# CPS BAR (ESTILO IMAGEN)
# ===============================
$cpsBG = New-Object System.Windows.Forms.Panel
$cpsBG.Size = '18,120'
$cpsBG.Location = '260,45'
$cpsBG.BackColor = [System.Drawing.Color]::FromArgb(45,45,45)
$f.Controls.Add($cpsBG)

$cpsFill = New-Object System.Windows.Forms.Panel
$cpsFill.Size = '18,40'
$cpsFill.BackColor = [System.Drawing.Color]::FromArgb(180,0,0)
$cpsBG.Controls.Add($cpsFill)

$cpsNum = New-Object System.Windows.Forms.Label
$cpsNum.ForeColor = 'White'
$cpsNum.Font = New-Object System.Drawing.Font("Segoe UI",9,[System.Drawing.FontStyle]::Bold)
$cpsNum.AutoSize = $true
$cpsNum.Location = '258,170'
$f.Controls.Add($cpsNum)

function UpdateCPSBar {
    $ratio = 0
    if ($MaxCPS -gt 0) { $ratio = $LeftCPS / $MaxCPS }
    $height = [int](120 * $ratio)
    $cpsFill.Height = [Math]::Max(2, $height)
    $cpsFill.Top = 120 - $cpsFill.Height
    $cpsNum.Text = $LeftCPS
}
UpdateCPSBar

# CONTROL LMB / RMB SOBRE LA BARRA
$cpsBG.Add_MouseDown({
    if ($_.Button -eq 'Left' -and $LeftCPS -lt $MaxCPS) { $LeftCPS++ }
    if ($_.Button -eq 'Right' -and $LeftCPS -gt $MinCPS) { $LeftCPS-- }
    UpdateCPSBar
})

# ===============================
# INFO
# ===============================
$info = New-Object System.Windows.Forms.Label
$info.Text = "Hold bind to click"
$info.ForeColor = 'Gray'
$info.Location = '20,80'
$f.Controls.Add($info)

# ===============================
# TIMERS
# ===============================
$LT = New-Object System.Windows.Forms.Timer
$LT.Interval = CPSDelay $LeftCPS
$LT.Add_Tick({
    LeftClick
    $LT.Interval = CPSDelay $LeftCPS
})

$MON = New-Object System.Windows.Forms.Timer
$MON.Interval = 5
$MON.Add_Tick({
    if ($Enabled -and (IsBindDown) -and $LeftCPS -gt 0) {
        if (-not $LT.Enabled) {
            $LT.Interval = CPSDelay $LeftCPS
            $LT.Start()
        }
    } else {
        if ($LT.Enabled) { $LT.Stop() }
    }
})
$MON.Start()

# ===============================
# CLEAN EXIT
# ===============================
$f.Add_FormClosing({
    $LT.Stop()
    $MON.Stop()
})

[System.Windows.Forms.Application]::Run($f)
