$apiSignature = @"
using System;
using System.Runtime.InteropServices;

public class API {
    [DllImport("user32.dll")] 
    public static extern short GetAsyncKeyState(int vKey);
    
    [DllImport("user32.dll")]
    public static extern uint SendInput(uint nInputs, INPUT[] pInputs, int cbSize);
    
    [DllImport("user32.dll")]
    public static extern IntPtr GetMessageExtraInfo();
    
    [StructLayout(LayoutKind.Sequential)]
    public struct INPUT {
        public uint type;
        public MOUSEINPUT mi;
    }
    
    [StructLayout(LayoutKind.Sequential)]
    public struct MOUSEINPUT {
        public int dx;
        public int dy;
        public uint mouseData;
        public uint dwFlags;
        public uint time;
        public IntPtr dwExtraInfo;
    }
    
    public const int INPUT_MOUSE = 0;
    public const uint MOUSEEVENTF_MOVE = 0x0001;
    public const uint MOUSEEVENTF_LEFTDOWN = 0x0002;
    public const uint MOUSEEVENTF_LEFTUP = 0x0004;
    public const uint MOUSEEVENTF_RIGHTDOWN = 0x0008;
    public const uint MOUSEEVENTF_RIGHTUP = 0x0010;
}
"@
Add-Type -TypeDefinition $apiSignature

$script:LeftBindKey = 0
$script:RightBindKey = 0
$script:LeftCPS = 12
$script:RightCPS = 12
$script:MinCPS = 1
$script:MaxCPS = 25
$script:JitterEnabled = $false

$script:stopwatch = [System.Diagnostics.Stopwatch]::StartNew()
$script:lastLeftClick = 0
$script:lastRightClick = 0
$script:nextLeftDelay = 0
$script:nextRightDelay = 0

function IsKeyDown($k) {
    if($k -eq 0) { return $false }
    return (([API]::GetAsyncKeyState($k) -band 0x8000) -ne 0)
}

function GetKeyName($k) {
    $names = @{0="...";1="LMB";2="RMB";4="MMB";5="MB4";6="MB5";32="Space";16="Shift";17="Ctrl";18="Alt"}
    65..90|%{$names[$_]=[char]$_}
    112..123|%{$names[$_]="F"+($_-111)}
    if($names[$k]){return $names[$k]}
    return "K:$k"
}

function GetNextDelay($cps) {
    if ($cps -le 0) { return 1000 }
    $baseMs = 1000.0 / $cps
    $variance = $baseMs * 0.20 
    $random = Get-Random -Minimum (-$variance) -Maximum ($variance)
    return ($baseMs + $random)
}

function SendMouseInput($flags) {
    $input = New-Object API+INPUT
    $input.type = [API]::INPUT_MOUSE
    $input.mi.dx = 0
    $input.mi.dy = 0
    $input.mi.mouseData = 0
    $input.mi.dwFlags = $flags
    $input.mi.time = 0
    $input.mi.dwExtraInfo = [API]::GetMessageExtraInfo()
    
    $inputs = @($input)
    [void][API]::SendInput(1, $inputs, [System.Runtime.InteropServices.Marshal]::SizeOf($input))
}

function DoLeftClick {
    if ($script:JitterEnabled) {
        $jx = (Get-Random -Min -2 -Max 3)
        $jy = (Get-Random -Min -2 -Max 3)
        
        $moveInput = New-Object API+INPUT
        $moveInput.type = [API]::INPUT_MOUSE
        $moveInput.mi.dx = $jx
        $moveInput.mi.dy = $jy
        $moveInput.mi.dwFlags = [API]::MOUSEEVENTF_MOVE
        $moveInput.mi.dwExtraInfo = [API]::GetMessageExtraInfo()
        
        [void][API]::SendInput(1, @($moveInput), [System.Runtime.InteropServices.Marshal]::SizeOf($moveInput))
        Start-Sleep -Milliseconds 1
    }
    
    SendMouseInput ([API]::MOUSEEVENTF_LEFTDOWN)
    Start-Sleep -Milliseconds (Get-Random -Minimum 10 -Maximum 30)
    SendMouseInput ([API]::MOUSEEVENTF_LEFTUP)
}

function DoRightClick {
    if ($script:JitterEnabled) {
        $jx = (Get-Random -Min -2 -Max 3)
        $jy = (Get-Random -Min -2 -Max 3)
        
        $moveInput = New-Object API+INPUT
        $moveInput.type = [API]::INPUT_MOUSE
        $moveInput.mi.dx = $jx
        $moveInput.mi.dy = $jy
        $moveInput.mi.dwFlags = [API]::MOUSEEVENTF_MOVE
        $moveInput.mi.dwExtraInfo = [API]::GetMessageExtraInfo()
        
        [void][API]::SendInput(1, @($moveInput), [System.Runtime.InteropServices.Marshal]::SizeOf($moveInput))
        Start-Sleep -Milliseconds 1
    }
    
    SendMouseInput ([API]::MOUSEEVENTF_RIGHTDOWN)
    Start-Sleep -Milliseconds (Get-Random -Minimum 10 -Maximum 30)
    SendMouseInput ([API]::MOUSEEVENTF_RIGHTUP)
}

