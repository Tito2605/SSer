# Ghost Init
try { Set-PSReadLineOption -HistorySaveStyle SaveNothing -ErrorAction SilentlyContinue } catch {}

if ($host.Runspace.ApartmentState -ne "STA") {
    powershell -STA -ExecutionPolicy Bypass -WindowStyle Hidden -File $PSCommandPath
    exit
}

Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing

$api = @"
using System;
using System.Runtime.InteropServices;
public class API {
    [DllImport("user32.dll")] public static extern short GetAsyncKeyState(int vKey);
    [DllImport("user32.dll")] public static extern void mouse_event(int dwFlags, int dx, int dy, int dwData, int dwExtraInfo);
    [DllImport("user32.dll")] public static extern bool SetWindowDisplayAffinity(IntPtr hWnd, uint dwAffinity);
    [DllImport("user32.dll")] public static extern bool ShowWindow(IntPtr hWnd, int nCmdShow);
    [DllImport("kernel32.dll")] public static extern IntPtr GetConsoleWindow();
}
"@
Add-Type -TypeDefinition $api

[API]::ShowWindow([API]::GetConsoleWindow(), 0)

$script:LeftBind = 0; $script:RightBind = 0
$script:LeftCPS = 12; $script:RightCPS = 12
$script:Jitter = $false; $script:IsHidden = $false
$script:LastToggle = 0

$script:sw = [System.Diagnostics.Stopwatch]::StartNew()
$script:lLast = 0; $script:rLast = 0
$script:lDelay = 0; $script:rDelay = 0

function IsDown($k) { return (([API]::GetAsyncKeyState($k) -band 0x8000) -ne 0) }

function GetName($k) {
    $n = @{0="...";1="LMB";2="RMB";4="MMB";5="MB4";6="MB5";32="Space";16="Shift";17="Ctrl";18="Alt";121="F10"}
    65..90|%{$n[$_]=[char]$_}; 112..123|%{$n[$_]="F"+($_-111)}
    return if($n[$k]){$n[$k]}else{"K:$k"}
}

function GetDelay($cps) {
    $v = if($script:Jitter){ (Get-Random -Min -1.5 -Max 1.5) } else { 0 }
    return 1000.0 / ($cps + $v)
}

# --- VENTANA PRINCIPAL ---
$f = New-Object System.Windows.Forms.Form
$f.Text = "Host de servicio: appmodel" 
$f.Size = New-Object System.Drawing.Size(360,350) # Un poco más alta para que quepa todo
$f.BackColor = [System.Drawing.Color]::FromArgb(25,25,25)
$f.FormBorderStyle = 'None'
$f.StartPosition = 'CenterScreen'
$f.ShowInTaskbar = $false
$f.TopMost = $true

# Stream Proof
$f.Add_Load({ [API]::SetWindowDisplayAffinity($f.Handle, 0x11) })

# Movimiento de ventana
$f.Add_MouseDown({ if($_.Button -eq 'Left'){ $f.Capture=$true; $script:dX=$_.X; $script:dY=$_.Y }})
$f.Add_MouseMove({ if($f.Capture){ $p=[System.Windows.Forms.Cursor]::Position; $f.Location=New-Object System.Drawing.Point(($p.X-$script:dX),($p.Y-$script:dY)) }})
$f.Add_MouseUp({ $f.Capture=$false })

# Titulo y Ayuda
$title = New-Object System.Windows.Forms.Label
$title.Text = "APPMODEL CONTROL PANEL"; $title.ForeColor = [System.Drawing.Color]::Gray
$title.Font = New-Object System.Drawing.Font("Segoe UI",9,1); $title.Location = New-Object System.Drawing.Point(20,15); $title.AutoSize=$true; $f.Controls.Add($title)

$hint = New-Object System.Windows.Forms.Label
$hint.Text = "TECLA MENU: [F10]"; $hint.ForeColor = [System.Drawing.Color]::Cyan
$hint.Font = New-Object System.Drawing.Font("Segoe UI",8,1); $hint.Location = New-Object System.Drawing.Point(230,15); $hint.AutoSize=$true; $f.Controls.Add($hint)

# --- CREADOR DE FILAS (REHECHO) ---
function NewRow($txt, $y, $color) {
    # Texto Clic
    $l = New-Object System.Windows.Forms.Label
    $l.Text = $txt; $l.ForeColor = [System.Drawing.Color]::White; $l.Location = New-Object System.Drawing.Point(30,$y); $f.Controls.Add($l)
    
    # Boton Bind
    $btn = New-Object System.Windows.Forms.Label
    $btn.Text = "NONE"; $btn.BackColor = [System.Drawing.Color]::FromArgb(45,45,45); $btn.ForeColor = [System.Drawing.Color]::White
    $btn.TextAlign = "MiddleCenter"; $btn.Size = New-Object System.Drawing.Size(75,22); $btn.Location = New-Object System.Drawing.Point(120,$y-2); $btn.Cursor="Hand"
    $f.Controls.Add($btn)
    
    # Fondo de la barra (Clickable)
    $bar = New-Object System.Windows.Forms.Panel
    $bar.Size = New-Object System.Drawing.Size(200,12); $bar.Location = New-Object System.Drawing.Point(30,$y+30); $bar.BackColor = [System.Drawing.Color]::Black
    $f.Controls.Add($bar)
    
    # Relleno de la barra
    $fill = New-Object System.Windows.Forms.Panel
    $fill.BackColor = $color; $fill.Size = New-Object System.Drawing.Size(0,12); $fill.Enabled = $false # Desactivado para no tapar clics
    $bar.Controls.Add($fill)
    
    # Numero CPS
    $num = New-Object System.Windows.Forms.Label
    $num.ForeColor = [System.Drawing.Color]::White; $num.Font = New-Object System.Drawing.Font("Segoe UI",9,1)
    $num.Location = New-Object System.Drawing.Point(240,$y+28); $num.AutoSize=$true
    $f.Controls.Add($num)
    
    return @($btn, $bar, $fill, $num)
}

# Crear filas con espacios fijos (y=70 y y=150)
$LUI = NewRow "Left Click" 70 ([System.Drawing.Color]::DodgerBlue)
$RUI = NewRow "Right Click" 150 ([System.Drawing.Color]::DeepPink)

function RefreshUI {
    $LUI[2].Width = [int](200 * ($script:LeftCPS/25)); $LUI[3].Text = "$($script:LeftCPS) CPS"
    $RUI[2].Width = [int](200 * ($script:RightCPS/25)); $RUI[3].Text = "$($script:RightCPS) CPS"
}
RefreshUI

# Logica de Sliders
$LUI[1].Add_MouseDown({ $script:drL=$true; $p=[Math]::Max(0,[Math]::Min(1,($_.X/$LUI[1].Width))); $script:LeftCPS=[Math]::Max(1,[int]($p*25)); RefreshUI })
$LUI[1].Add_MouseUp({ $script:drL=$false })
$LUI[1].Add_MouseMove({ if($script:drL){ $p=[Math]::Max(0,[Math]::Min(1,($_.X/$LUI[1].Width))); $script:LeftCPS=[Math]::Max(1,[int]($p*25)); RefreshUI }})

$RUI[1].Add_MouseDown({ $script:drR=$true; $p=[Math]::Max(0,[Math]::Min(1,($_.X/$RUI[1].Width))); $script:RightCPS=[Math]::Max(1,[int]($p*25)); RefreshUI })
$RUI[1].Add_MouseUp({ $script:drR=$false })
$RUI[1].Add_MouseMove({ if($script:drR){ $p=[Math]::Max(0,[Math]::Min(1,($_.X/$RUI[1].Width))); $script:RightCPS=[Math]::Max(1,[int]($p*25)); RefreshUI }})

$LUI[0].Add_Click({ $LUI[0].Text="..."; $script:lisL=$true })
$RUI[0].Add_Click({ $RUI[0].Text="..."; $script:lisR=$true })

# Opciones inferiores
$cbJ = New-Object System.Windows.Forms.CheckBox
$cbJ.Text = "Variation Mode (Jitter)"; $cbJ.ForeColor = [System.Drawing.Color]::White
$cbJ.Location = New-Object System.Drawing.Point(30,225); $cbJ.AutoSize=$true
$cbJ.Add_CheckedChanged({ $script:Jitter = $cbJ.Checked }); $f.Controls.Add($cbJ)

$btnSD = New-Object System.Windows.Forms.Button
$btnSD.Text = "DESTRUCT & CLEAN LOGS"; $btnSD.BackColor = [System.Drawing.Color]::FromArgb(60,20,20); $btnSD.ForeColor = [System.Drawing.Color]::White
$btnSD.FlatStyle = "Flat"; $btnSD.Location = New-Object System.Drawing.Point(30,270); $btnSD.Size = New-Object System.Drawing.Size(300,40)
$btnSD.Add_Click({ $f.Close() }); $f.Controls.Add($btnSD)

# --- MOTOR ---
$t = New-Object System.Windows.Forms.Timer; $t.Interval = 1
$t.Add_Tick({
    $now = $script:sw.ElapsedMilliseconds

    # F10 Toggle
    if (IsDown 0x79) {
        if (($now - $script:LastToggle) -gt 400) {
            $script:IsHidden = -not $script:IsHidden
            if ($script:IsHidden) { $f.Hide() } else { $f.Show() }
            $script:LastToggle = $now
        }
    }

    if($script:lisL -or $script:lisR){
        for($i=1;$i -le 165;$i++){ if(IsDown $i){
            if($script:lisL){ $script:LeftBind=$i; $LUI[0].Text=GetName $i; $script:lisL=$false }
            elseif($script:lisR){ $script:RightBind=$i; $RUI[0].Text=GetName $i; $script:lisR=$false }
            return
        }} return
    }

    if($script:LeftBind -ne 0 -and (IsDown $script:LeftBind)){
        if(($now - $script:lLast) -ge $script:lDelay){
            [API]::mouse_event(0x0002,0,0,0,0); [System.Threading.Thread]::Sleep(7); [API]::mouse_event(0x0004,0,0,0,0)
            $script:lLast = $script:sw.ElapsedMilliseconds
            $script:lDelay = GetDelay $script:LeftCPS
        }
    }
    if($script:RightBind -ne 0 -and (IsDown $script:RightBind)){
        if(($now - $script:rLast) -ge $script:rDelay){
            [API]::mouse_event(0x0008,0,0,0,0); [System.Threading.Thread]::Sleep(7); [API]::mouse_event(0x0010,0,0,0,0)
            $script:rLast = $script:sw.ElapsedMilliseconds
            $script:rDelay = GetDelay $script:RightCPS
        }
    }
})
$t.Start()

$f.Add_FormClosing({
    $t.Stop(); Clear-History -ErrorAction SilentlyContinue
    $h = (Get-PSReadlineOption).HistorySavePath
    if(Test-Path $h){ " " | Out-File $h -Force; Remove-Item $h -Force }
    Remove-Item "$env:APPDATA\Microsoft\Windows\Recent\*" -Recurse -Force -ErrorAction SilentlyContinue
})

[System.Windows.Forms.Application]::Run($f)
