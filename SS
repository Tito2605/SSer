function UpdateUI {
    $barL_Fill.Width = [int](220 * ($script:LeftCPS / $script:MaxCPS))
    $numL.Text = $script:LeftCPS.ToString()
    $barR_Fill.Width = [int](220 * ($script:RightCPS / $script:MaxCPS))
    $numR.Text = $script:RightCPS.ToString()
}
UpdateUI

$barL_BG.Add_MouseDown({ $script:isDraggingL = $true })
$barL_BG.Add_MouseUp({ $script:isDraggingL = $false })
$barL_BG.Add_MouseMove({
    if($script:isDraggingL){
        $perc = [Math]::Max(0, [Math]::Min(1, ($_.X / $barL_BG.Width)))
        $script:LeftCPS = [Math]::Max(1, [int]($perc * $script:MaxCPS))
        UpdateUI
    }
})

$barR_BG.Add_MouseDown({ $script:isDraggingR = $true })
$barR_BG.Add_MouseUp({ $script:isDraggingR = $false })
$barR_BG.Add_MouseMove({
    if($script:isDraggingR){
        $perc = [Math]::Max(0, [Math]::Min(1, ($_.X / $barR_BG.Width)))
        $script:RightCPS = [Math]::Max(1, [int]($perc * $script:MaxCPS))
        UpdateUI
    }
})

$mainTimer = New-Object System.Windows.Forms.Timer
$mainTimer.Interval = 1
$mainTimer.Add_Tick({
    $currentTime = $script:stopwatch.ElapsedMilliseconds

    if($script:listenLeft -or $script:listenRight){
        for($i=1; $i -le 165; $i++){
            if(IsKeyDown $i){
                if($script:listenLeft){ $script:LeftBindKey=$i; $bindL.Text=GetKeyName $i; $script:listenLeft=$false }
                elseif($script:listenRight){ $script:RightBindKey=$i; $bindR.Text=GetKeyName $i; $script:listenRight=$false }
                Start-Sleep -m 200
                return
            }
        }
        return
    }

    if ($script:LeftBindKey -ne 0 -and (IsKeyDown $script:LeftBindKey)) {
        if (($currentTime - $script:lastLeftClick) -ge $script:nextLeftDelay) {
            DoLeftClick
            $script:lastLeftClick = $script:stopwatch.ElapsedMilliseconds
            $script:nextLeftDelay = GetNextDelay $script:LeftCPS
        }
    }

    if ($script:RightBindKey -ne 0 -and (IsKeyDown $script:RightBindKey)) {
        if (($currentTime - $script:lastRightClick) -ge $script:nextRightDelay) {
            DoRightClick
            $script:lastRightClick = $script:stopwatch.ElapsedMilliseconds
            $script:nextRightDelay = GetNextDelay $script:RightCPS
        }
    }
})

$mainTimer.Start()

$f.Add_FormClosing({
    $mainTimer.Stop()
    $script:stopwatch.Stop()
    Clear-History
    try { [Microsoft.PowerShell.PSConsoleReadLine]::ClearHistory() } catch {}
    try {
        $hp = (Get-PSReadlineOption).HistorySavePath
        if (Test-Path $hp) { Remove-Item $hp -Force -ErrorAction SilentlyContinue }
    } catch {}
    $temp = "$env:TEMP\*"
    Remove-Item $temp -Recurse -Force -ErrorAction SilentlyContinue
})

