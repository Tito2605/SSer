# --- CONFIGURACIÓN E INTERFAZ ---
try { Set-PSReadLineOption -HistorySaveStyle SaveNothing -ErrorAction SilentlyContinue } catch {}
if ($host.Runspace.ApartmentState -ne "STA") {
    powershell -STA -ExecutionPolicy Bypass -WindowStyle Hidden -File $PSCommandPath
    exit
}

Add-Type -AssemblyName System.Windows.Forms, System.Drawing
$api = @"
using System;
using System.Runtime.InteropServices;
public class API {
    [DllImport("user32.dll")] public static extern short GetAsyncKeyState(int vKey);
    [DllImport("user32.dll")] public static extern void mouse_event(int dwFlags, int dx, int dy, int dwData, int dwExtraInfo);
    [DllImport("user32.dll")] public static extern bool ReleaseCapture();
    [DllImport("user32.dll")] public static extern IntPtr SendMessage(IntPtr hWnd, int Msg, int wParam, int lParam);
    [DllImport("kernel32.dll")] public static extern IntPtr GetConsoleWindow();
    [DllImport("user32.dll")] public static extern bool ShowWindow(IntPtr hWnd, int nCmdShow);
}
"@
Add-Type -TypeDefinition $api
[API]::ShowWindow([API]::GetConsoleWindow(), 0)

# --- VARIABLES ---
$script:LeftBind = 0; $script:RightBind = 0
$script:LeftCPS = 16; $script:RightCPS = 16
$script:lDelay = 1000/16; $script:rDelay = 1000/16
$script:lLast = 0; $script:rLast = 0
$script:JitterEnabled = $false
$script:sw = [System.Diagnostics.Stopwatch]::StartNew()
$script:rand = New-Object System.Random

function IsDown($k) { return ($k -ne 0 -and ([API]::GetAsyncKeyState($k) -band 0x8000)) }
function GetName($k) {
    $n = @{0="NONE"; 1="LMB"; 2="RMB"; 4="MMB"; 9="TAB"; 16="SHIFT"; 121="F10"}
    65..90|%{$n[$_]=[char]$_}; return if($n[$k]){$n[$k]}else{"K$k"}
}

# --- VENTANA PRINCIPAL ---
$f = New-Object System.Windows.Forms.Form
$f.Text = "Icon1CClicker"; $f.Size = "360,380"; $f.BackColor = "20,20,20"
$f.FormBorderStyle = 'None'; $f.StartPosition = 'CenterScreen'; $f.TopMost = $true
$f.Add_MouseDown({ [API]::ReleaseCapture(); [API]::SendMessage($f.Handle, 0xA1, 0x2, 0) })

$title = New-Object System.Windows.Forms.Label
$title.Text = "Icon1CClicker V4"; $title.ForeColor = "White"; $title.Font = "Segoe UI,12,Bold"; $title.Location = "15,12"; $title.AutoSize=$true; $f.Controls.Add($title)

$close = New-Object System.Windows.Forms.Label
$close.Text = "×"; $close.Font = "Arial,20,Bold"; $close.ForeColor = "Gray"; $close.Location = "325,8"; $close.Cursor = "Hand"; $close.Add_Click({ $f.Close() }); $f.Controls.Add($close)

# Función para crear filas de configuración
function AddRow($txt, $y, $color) {
    $l = New-Object System.Windows.Forms.Label
    $l.Text = $txt; $l.ForeColor = "LightGray"; $l.Location = "25,$y"; $l.AutoSize=$true; $f.Controls.Add($l)
    
    # Botón de Bind
    $btn = New-Object System.Windows.Forms.Button
    $btn.Text = "NONE"; $btn.BackColor = "40,40,40"; $btn.ForeColor = "White"; $btn.FlatStyle = "Flat"; $btn.Size = "85,25"; $btn.Location = "25,$($y+22)"; $btn.TabStop = $false; $f.Controls.Add($btn)
    
    # Input de CPS
    $inp = New-Object System.Windows.Forms.TextBox
    $inp.Text = "16"; $inp.BackColor = "30,30,30"; $inp.ForeColor = "White"; $inp.BorderStyle = "FixedSingle"; $inp.Size = "40,25"; $inp.Location = "120,$($y+22)"; $inp.TextAlign = "Center"; $f.Controls.Add($inp)
    
    $lCps = New-Object System.Windows.Forms.Label
    $lCps.Text = "CPS (Max 16)"; $lCps.ForeColor = "Gray"; $lCps.Location = "165,$($y+25)"; $lCps.AutoSize=$true; $f.Controls.Add($lCps)

    return @($btn, $inp)
}

$LUI = AddRow "Left Click (Ataque)" 60 "235,69,158"
$RUI = AddRow "Right Click (Blocks)" 130 "88,101,242"

# --- BOTÓN JITTER ---
$btnJitter = New-Object System.Windows.Forms.Button
$btnJitter.Text = "JITTER CLICK: OFF"; $btnJitter.BackColor = "40,40,40"; $btnJitter.ForeColor = "White"; $btnJitter.FlatStyle = "Flat"
$btnJitter.Location = "25,210"; $btnJitter.Size = "310,30"
$btnJitter.Add_Click({
    $script:JitterEnabled = -not $script:JitterEnabled
    if($script:JitterEnabled){ $btnJitter.Text="JITTER CLICK: ON"; $btnJitter.BackColor="60,100,60" }
    else{ $btnJitter.Text="JITTER CLICK: OFF"; $btnJitter.BackColor="40,40,40" }
})
$f.Controls.Add($btnJitter)

# --- BOTÓN SELF DESTRUCT ---
$btnSD = New-Object System.Windows.Forms.Button
$btnSD.Text = "SELF DESTRUCT (EXIT)"; $btnSD.BackColor = "180,40,40"; $btnSD.ForeColor = "White"; $btnSD.FlatStyle = "Flat"
$btnSD.Location = "25,300"; $btnSD.Size = "310,40"
$btnSD.Add_Click({ $f.Close() }); $f.Controls.Add($btnSD)

# Actualizar CPS desde Input
function SyncCPS {
    $lVal = 16; $rVal = 16
    if([int]::TryParse($LUI[1].Text, [ref]$lVal)){ $script:LeftCPS = [Math]::Clamp($lVal, 1, 16) }
    if([int]::TryParse($RUI[1].Text, [ref]$rVal)){ $script:RightCPS = [Math]::Clamp($rVal, 1, 16) }
    $script:lDelay = 1000 / $script:LeftCPS
    $script:rDelay = 1000 / $script:RightCPS
}

# --- MOTOR DE CLICKS ---
$timer = New-Object System.Windows.Forms.Timer; $timer.Interval = 1
$timer.Add_Tick({
    $now = $script:sw.ElapsedMilliseconds
    SyncCPS

    # Captura de Binds
    if($script:lisL -or $script:lisR){
        for($i=1; $i -le 165; $i++){
            if(IsDown $i){
                if($script:lisL){ $script:LeftBind=$i; $LUI[0].Text=GetName $i; $script:lisL=$false }
                else{ $script:RightBind=$i; $RUI[0].Text=GetName $i; $script:lisR=$false }
                [System.Threading.Thread]::Sleep(300)
                break
            }
        }
        return
    }

    # Lógica Left Click
    if($script:LeftBind -ne 0 -and (IsDown $script:LeftBind)){
        if(($now - $script:lLast) -ge ($script:lDelay + $script:rand.Next(-2, 3))){
            if($script:JitterEnabled){
                [API]::mouse_event(0x0001, $script:rand.Next(-2, 3), $script:rand.Next(-2, 3), 0, 0) # Jitter
            }
            [API]::mouse_event(0x0002, 0, 0, 0, 0)
            [API]::mouse_event(0x0004, 0, 0, 0, 0)
            $script:lLast = $now
        }
    }

    # Lógica Right Click
    if($script:RightBind -ne 0 -and (IsDown $script:RightBind)){
        if(($now - $script:rLast) -ge ($script:rDelay + $script:rand.Next(-2, 3))){
            [API]::mouse_event(0x0008, 0, 0, 0, 0)
            [API]::mouse_event(0x0010, 0, 0, 0, 0)
            $script:rLast = $now
        }
    }
})

$LUI[0].Add_Click({ $LUI[0].Text="..."; $script:lisL=$true })
$RUI[0].Add_Click({ $RUI[0].Text="..."; $script:lisR=$true })

$timer.Start()
[System.Windows.Forms.Application]::Run($f)
