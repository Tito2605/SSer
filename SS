# API
Add-Type @"
using System;
using System.Runtime.InteropServices;
public class API {
    [DllImport("user32.dll")] public static extern void mouse_event(int f, int x, int y, int d, int e);
    [DllImport("user32.dll")] public static extern short GetAsyncKeyState(int k);
}
"@

# Variables
$script:leftKey = 0
$script:rightKey = 0
$script:leftEnabled = $false
$script:rightEnabled = $false
$script:leftClicking = $false
$script:rightClicking = $false
$script:listenLeft = $false
$script:listenRight = $false

function KeyName($k) {
    $n = @{1="LMB";2="RMB";4="MMB";5="MB4";6="MB5";32="Space";16="Shift";17="Ctrl";18="Alt"}
    65..90|%{$n[$_]=[char]$_}
    112..117|%{$n[$_]="F"+($_-111)}
    if($n[$k]){return $n[$k]}
    "Key"
}

function IsKeyPressed($k) {
    ([API]::GetAsyncKeyState($k) -band 0x8000) -ne 0
}

function LeftClick {
    [API]::mouse_event(2,0,0,0,0)
    [API]::mouse_event(4,0,0,0,0)
}

function RightClick {
    [API]::mouse_event(8,0,0,0,0)
    [API]::mouse_event(16,0,0,0,0)
}

function Monitor {
    # Left click monitoring - NO detecta su propio click si es LMB
    if($script:leftEnabled -and $script:leftKey -gt 0){
        $pressed = IsKeyPressed $script:leftKey
        
        # Si la tecla es LMB (1), ignorar clicks del autoclicker
        if($script:leftKey -eq 1){
            # Solo detectar si el usuario realmente presionó, no el autoclicker
            if($pressed -and !$script:leftClicking){
                $script:leftClicking = $true
                $leftTimer.Start()
            }
            elseif(!$pressed -and $script:leftClicking){
                $script:leftClicking = $false
                $leftTimer.Stop()
            }
        }
        else {
            # Para otras teclas, funciona normal
            if($pressed){
                if(!$leftTimer.Enabled){$leftTimer.Start()}
            } else {
                if($leftTimer.Enabled){$leftTimer.Stop()}
            }
        }
    }
    
    # Right click monitoring - NO detecta su propio click si es RMB
    if($script:rightEnabled -and $script:rightKey -gt 0){
        $pressed = IsKeyPressed $script:rightKey
        
        # Si la tecla es RMB (2), ignorar clicks del autoclicker
        if($script:rightKey -eq 2){
            if($pressed -and !$script:rightClicking){
                $script:rightClicking = $true
                $rightTimer.Start()
            }
            elseif(!$pressed -and $script:rightClicking){
                $script:rightClicking = $false
                $rightTimer.Stop()
            }
        }
        else {
            if($pressed){
                if(!$rightTimer.Enabled){$rightTimer.Start()}
            } else {
                if($rightTimer.Enabled){$rightTimer.Stop()}
            }
        }
    }
    
    # Listen for keys
    if($script:listenLeft){
        $k = 0
        1..254|%{if(IsKeyPressed $_){$k=$_;return}}
        if($k -gt 0){
            if($k -eq 27){
                $script:leftKey=0
                $lk.Text="none"
                $lk.ForeColor=[System.Drawing.Color]::Gray
                $script:leftEnabled=$false
            } else {
                $script:leftKey=$k
                $lk.Text=KeyName $k
                $lk.ForeColor=[System.Drawing.Color]::White
                $script:leftEnabled=$true
            }
            $script:listenLeft=$false
            Start-Sleep -Milliseconds 200
        }
    }
    
    if($script:listenRight){
        $k = 0
        1..254|%{if(IsKeyPressed $_){$k=$_;return}}
        if($k -gt 0){
            if($k -eq 27){
                $script:rightKey=0
                $rk.Text="none"
                $rk.ForeColor=[System.Drawing.Color]::Gray
                $script:rightEnabled=$false
            } else {
                $script:rightKey=$k
                $rk.Text=KeyName $k
                $rk.ForeColor=[System.Drawing.Color]::White
                $script:rightEnabled=$true
            }
            $script:listenRight=$false
            Start-Sleep -Milliseconds 200
        }
    }
}

