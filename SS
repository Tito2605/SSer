# ===============================
# STA
# ===============================
if ($host.Runspace.ApartmentState -ne "STA") {
    powershell -STA -ExecutionPolicy Bypass -File $PSCommandPath
    exit
}

Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing

Add-Type @"
using System;
using System.Runtime.InteropServices;
public class API {
    [DllImport("user32.dll")] public static extern short GetAsyncKeyState(int vKey);
    [DllImport("user32.dll")] public static extern void mouse_event(int a, int b, int c, int d, int e);
}
"@

# ===============================
# CONFIG
# ===============================
$script:Enabled = $true

$script:LeftBind  = 0x01   # LMB (puede cambiarse)
$script:RightBind = 0x02   # RMB

$script:LeftCPS  = 12
$script:RightCPS = 12

$script:MinCPS = 0
$script:MaxCPS = 25

# ===============================
# UTILS
# ===============================
function KeyDown($vk) {
    return (([API]::GetAsyncKeyState($vk) -band 0x8000) -ne 0)
}

function CPSDelay($cps) {
    if ($cps -le 0) { return 9999 }
    $base = 1000.0 / $cps
    $jitter = Get-Random -Minimum (-$base * 0.12) -Maximum ($base * 0.12)
    return [Math]::Max(1,[int]($base + $jitter))
}

function LeftClick {
    [API]::mouse_event(2,0,0,0,0)
    [API]::mouse_event(4,0,0,0,0)
}

function RightClick {
    [API]::mouse_event(8,0,0,0,0)
    [API]::mouse_event(16,0,0,0,0)
}

# ===============================
# CLICK THREADS (REAL CPS)
# ===============================
$script:leftThread = [System.Threading.Thread]{
    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    $next = 0
    while ($true) {
        if ($script:Enabled -and (KeyDown $script:LeftBind) -and $script:LeftCPS -gt 0) {
            if ($sw.ElapsedMilliseconds -ge $next) {
                LeftClick
                $next = $sw.ElapsedMilliseconds + (CPSDelay $script:LeftCPS)
            }
        } else {
            $next = $sw.ElapsedMilliseconds
        }
        Start-Sleep -Milliseconds 1
    }
}
$script:leftThread.IsBackground = $true
$script:leftThread.Start()

$script:rightThread = [System.Threading.Thread]{
    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    $next = 0
    while ($true) {
        if ($script:Enabled -and (KeyDown $script:RightBind) -and $script:RightCPS -gt 0) {
            if ($sw.ElapsedMilliseconds -ge $next) {
                RightClick
                $next = $sw.ElapsedMilliseconds + (CPSDelay $script:RightCPS)
            }
        } else {
            $next = $sw.ElapsedMilliseconds
        }
        Start-Sleep -Milliseconds 1
    }
}
$script:rightThread.IsBackground = $true
$script:rightThread.Start()

# ===============================
# UI (simple, estable)
# ===============================
$f = New-Object System.Windows.Forms.Form
$f.Text = "Icon1CClicker"
$f.Size = New-Object System.Drawing.Size(320,150)
$f.BackColor = [System.Drawing.Color]::FromArgb(18,18,18)
$f.FormBorderStyle = 'FixedSingle'
$f.MaximizeBox = $false

$lbl = New-Object System.Windows.Forms.Label
$lbl.Text = "LMB CPS: $($script:LeftCPS) | RMB CPS: $($script:RightCPS)"
$lbl.ForeColor = 'White'
$lbl.AutoSize = $true
$lbl.Location = '20,20'
$f.Controls.Add($lbl)

$f.Add_KeyDown({
    if ($_.KeyCode -eq 'Up'   -and $script:LeftCPS -lt 25) { $script:LeftCPS++ }
    if ($_.KeyCode -eq 'Down' -and $script:LeftCPS -gt 0 ) { $script:LeftCPS-- }
    if ($_.KeyCode -eq 'Right'-and $script:RightCPS -lt 25){ $script:RightCPS++ }
    if ($_.KeyCode -eq 'Left' -and $script:RightCPS -gt 0 ){ $script:RightCPS-- }
    $lbl.Text = "LMB CPS: $($script:LeftCPS) | RMB CPS: $($script:RightCPS)"
})

[System.Windows.Forms.Application]::Run($f)
