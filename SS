# ===============================
# API DE WINDOWS (USER32)
# ===============================
$apiSignature = @"
using System;
using System.Runtime.InteropServices;
using System.Diagnostics;

public class API {
    [DllImport("user32.dll")] public static extern short GetAsyncKeyState(int vKey);
    [DllImport("user32.dll")] public static extern void mouse_event(int dwFlags, int dx, int dy, int dwData, int dwExtraInfo);
    
    // Constantes de Mouse
    public const int MOUSEEVENTF_MOVE       = 0x0001;
    public const int MOUSEEVENTF_LEFTDOWN   = 0x0002;
    public const int MOUSEEVENTF_LEFTUP     = 0x0004;
    public const int MOUSEEVENTF_RIGHTDOWN  = 0x0008;
    public const int MOUSEEVENTF_RIGHTUP    = 0x0010;
}
"@
Add-Type -TypeDefinition $apiSignature

# ===============================
# CONFIGURACIÓN Y ESTADO
# ===============================
$script:LeftBindKey = 0
$script:RightBindKey = 0
$script:LeftCPS = 12
$script:RightCPS = 12
$script:MinCPS = 1
$script:MaxCPS = 25 # Puedes subir esto si quieres más velocidad

# Control de tiempos
$script:stopwatch = [System.Diagnostics.Stopwatch]::StartNew()
$script:lastLeftClick = 0
$script:lastRightClick = 0
$script:nextLeftDelay = 0
$script:nextRightDelay = 0

# Contadores para "Real CPS"
$script:leftClicksLog = New-Object System.Collections.Generic.List[long]
$script:rightClicksLog = New-Object System.Collections.Generic.List[long]

# Flags
$script:JitterEnabled = $false
$script:MAGIC = 0 # Extra info (0 es indetectable estándar)

# ===============================
# FUNCIONES LÓGICAS
# ===============================

function IsKeyDown($k) {
    if($k -eq 0) { return $false }
    return (([API]::GetAsyncKeyState($k) -band 0x8000) -ne 0)
}

function GetKeyName($k) {
    $names = @{0="...";1="LMB";2="RMB";4="MMB";5="MB4";6="MB5";32="Space";16="Shift";17="Ctrl";18="Alt"}
    65..90|%{$names[$_]=[char]$_}
    112..123|%{$names[$_]="F"+($_-111)} # F1-F12
    if($names[$k]){return $names[$k]}
    return "Key:$k"
}

# Calcula el retraso basado en CPS + Aleatoriedad
function GetNextDelay($cps) {
    if ($cps -le 0) { return 1000 }
    $baseMs = 1000.0 / $cps
    # Variación del 15% para humanizar
    $variance = $baseMs * 0.15 
    $random = Get-Random -Minimum (-$variance) -Maximum ($variance)
    return ($baseMs + $random)
}

function DoLeftClick {
    # Jitter (Movimiento)
    if ($script:JitterEnabled) {
        $jx = (Get-Random -Min -2 -Max 3)
        $jy = (Get-Random -Min -2 -Max 3)
        [API]::mouse_event([API]::MOUSEEVENTF_MOVE, $jx, $jy, 0, 0)
    }
    # Click
    [API]::mouse_event([API]::MOUSEEVENTF_LEFTDOWN, 0, 0, 0, $script:MAGIC)
    [API]::mouse_event([API]::MOUSEEVENTF_LEFTUP, 0, 0, 0, $script:MAGIC)
    
    # Registrar tiempo para Real CPS
    $script:leftClicksLog.Add($script:stopwatch.ElapsedMilliseconds)
}

function DoRightClick {
    if ($script:JitterEnabled) {
        $jx = (Get-Random -Min -2 -Max 3)
        $jy = (Get-Random -Min -2 -Max 3)
        [API]::mouse_event([API]::MOUSEEVENTF_MOVE, $jx, $jy, 0, 0)
    }
    [API]::mouse_event([API]::MOUSEEVENTF_RIGHTDOWN, 0, 0, 0, $script:MAGIC)
    [API]::mouse_event([API]::MOUSEEVENTF_RIGHTUP, 0, 0, 0, $script:MAGIC)
    
    $script:rightClicksLog.Add($script:stopwatch.ElapsedMilliseconds)
}

function UpdateRealCPS {
    $now = $script:stopwatch.ElapsedMilliseconds
    $threshold = $now - 1000
    
    # Limpiar registros viejos (> 1 seg)
    while ($script:leftClicksLog.Count -gt 0 -and $script:leftClicksLog[0] -lt $threshold) {
        $script:leftClicksLog.RemoveAt(0)
    }
    while ($script:rightClicksLog.Count -gt 0 -and $script:rightClicksLog[0] -lt $threshold) {
        $script:rightClicksLog.RemoveAt(0)
    }
    
    $script:lblRealLeft.Text = "Real: " + $script:leftClicksLog.Count + " cps"
    $script:lblRealRight.Text = "Real: " + $script:rightClicksLog.Count + " cps"
}

