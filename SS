# --- LOGIC UPDATERS ---
function UpdateUI {
    # Left
    $ratioL = $script:LeftCPS / $script:MaxCPS
    $barL_Fill.Width = [int](240 * $ratioL)
    $numL.Text = $script:LeftCPS.ToString()
    
    # Right
    $ratioR = $script:RightCPS / $script:MaxCPS
    $barR_Fill.Width = [int](240 * $ratioR)
    $numR.Text = $script:RightCPS.ToString()
}
UpdateUI

# Click en barra izquierda para cambiar CPS
$barL_BG.Add_MouseDown({
    if($_.Button -eq 'Left' -and $script:LeftCPS -lt $script:MaxCPS){ $script:LeftCPS++ }
    if($_.Button -eq 'Right' -and $script:LeftCPS -gt $script:MinCPS){ $script:LeftCPS-- }
    UpdateUI
})
# Click en barra derecha
$barR_BG.Add_MouseDown({
    if($_.Button -eq 'Left' -and $script:RightCPS -lt $script:MaxCPS){ $script:RightCPS++ }
    if($_.Button -eq 'Right' -and $script:RightCPS -gt $script:MinCPS){ $script:RightCPS-- }
    UpdateUI
})

# ===============================
# MAIN LOOP (GAME LOOP)
# ===============================
$mainTimer = New-Object System.Windows.Forms.Timer
$mainTimer.Interval = 1 # Intentar correr lo más rápido posible (aprox 15ms reales)
$mainTimer.Add_Tick({
    $currentTime = $script:stopwatch.ElapsedMilliseconds

    # 1. Escuchar teclas para Binding
    if($script:listenLeft -or $script:listenRight){
        for($i=1; $i -le 190; $i++){
            if(IsKeyDown $i){
                if($script:listenLeft){
                    if($i -eq 27) { $script:LeftBindKey=0; $bindL.Text="NONE"; $bindL.ForeColor=[System.Drawing.Color]::Gray }
                    else { $script:LeftBindKey=$i; $bindL.Text=GetKeyName $i; $bindL.ForeColor=[System.Drawing.Color]::White }
                    $script:listenLeft = $false
                }
                elseif($script:listenRight){
                    if($i -eq 27) { $script:RightBindKey=0; $bindR.Text="NONE"; $bindR.ForeColor=[System.Drawing.Color]::Gray }
                    else { $script:RightBindKey=$i; $bindR.Text=GetKeyName $i; $bindR.ForeColor=[System.Drawing.Color]::White }
                    $script:listenRight = $false
                }
                Start-Sleep -m 150 # Evitar doble registro
                return
            }
        }
        return # Si estamos escuchando bind, no clickear
    }

    # 2. Lógica de Click Izquierdo
    if ($script:LeftBindKey -ne 0 -and (IsKeyDown $script:LeftBindKey)) {
        if (($currentTime - $script:lastLeftClick) -ge $script:nextLeftDelay) {
            DoLeftClick
            $script:lastLeftClick = $currentTime
            $script:nextLeftDelay = GetNextDelay $script:LeftCPS
        }
    }

    # 3. Lógica de Click Derecho
    if ($script:RightBindKey -ne 0 -and (IsKeyDown $script:RightBindKey)) {
        if (($currentTime - $script:lastRightClick) -ge $script:nextRightDelay) {
            DoRightClick
            $script:lastRightClick = $currentTime
            $script:nextRightDelay = GetNextDelay $script:RightCPS
        }
    }
    
    # 4. Actualizar etiquetas de Real CPS (cada ~100ms para no laggear UI)
    if ($currentTime % 10 -lt 2) {
        UpdateRealCPS
    }
})

$mainTimer.Start()

$f.Add_FormClosing({
    $mainTimer.Stop()
    $script:stopwatch.Stop()
})

[System.Windows.Forms.Application]::Run($f)
