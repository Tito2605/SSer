# ===============================
# FORZAR STA
# ===============================
if ($host.Runspace.ApartmentState -ne "STA") {
    powershell -STA -ExecutionPolicy Bypass -File $PSCommandPath
    exit
}

Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing

# ===============================
# API
# ===============================
Add-Type @"
using System;
using System.Runtime.InteropServices;
public class API {
    [DllImport("user32.dll")] public static extern short GetAsyncKeyState(int vKey);
    [DllImport("user32.dll")] public static extern void mouse_event(int a, int b, int c, int d, int e);
    [DllImport("user32.dll")] public static extern IntPtr GetMessageExtraInfo();
}
"@

# ===============================
# CONFIG
# ===============================
$script:LeftBind = 0
$script:RightBind = 0
$script:LeftCPS = 12
$script:RightCPS = 12
$script:MinCPS = 1
$script:MaxCPS = 25

# Variables internas para evitar loops
$script:leftClickerActive = $false
$script:rightClickerActive = $false
$script:MAGIC = 0x1C0F1C

# ===============================
# FUNCIONES
# ===============================
function IsKeyDown($k) {
    if($k -eq 0) { return $false }
    return (([API]::GetAsyncKeyState($k) -band 0x8000) -ne 0)
}

function GetKeyName($k) {
    $names = @{0="none";1="LMB";2="RMB";4="MMB";5="MB4";6="MB5";32="Space";16="Shift";17="Ctrl";18="Alt"}
    65..90|%{$names[$_]=[char]$_}
    112..117|%{$names[$_]="F"+($_-111)}
    if($names[$k]){return $names[$k]}
    "Key"
}

function CPSDelay($cps) {
    $base = 1000.0 / $cps
    $jitter = Get-Random -Minimum (-$base * 0.12) -Maximum ($base * 0.12)
    return [Math]::Max(1, [int]($base + $jitter))
}

function LeftClick {
    [API]::mouse_event(2,0,0,0,$script:MAGIC)
    [API]::mouse_event(4,0,0,0,$script:MAGIC)
}

function RightClick {
    [API]::mouse_event(8,0,0,0,$script:MAGIC)
    [API]::mouse_event(16,0,0,0,$script:MAGIC)
}

# ===============================
# FORM
# ===============================
$f = New-Object System.Windows.Forms.Form
$f.Text = "Icon1CClicker"
$f.Size = New-Object System.Drawing.Size(360,250)
$f.StartPosition = 'CenterScreen'
$f.BackColor = [System.Drawing.Color]::FromArgb(18,18,18)
$f.FormBorderStyle = 'None'
$f.ShowInTaskbar = $true

# Drag simple
$f.Add_MouseDown({
    if($_.Button -eq 'Left' -and $_.Y -lt 40){
        $f.Capture = $true
        $script:dragX = $_.X
        $script:dragY = $_.Y
    }
})
$f.Add_MouseMove({
    if($f.Capture){
        $x = [System.Windows.Forms.Cursor]::Position.X - $script:dragX
        $y = [System.Windows.Forms.Cursor]::Position.Y - $script:dragY
        $f.Location = New-Object System.Drawing.Point($x,$y)
    }
})
$f.Add_MouseUp({$f.Capture = $false})

